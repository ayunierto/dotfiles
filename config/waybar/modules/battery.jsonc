{
  "battery": {
    "bat": "BAT0",
    // "adapter": "AC0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% ",
    "format-discharging": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-icons": ["", "", "", "", ""],
    "max-length": 25,
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%\nTime to: {timeTo}"
  }
}
