# Variables compartidas entre arch-install, arch-users.sh y arch-desktop.sh
# Ajusta a tu gusto antes de ejecutar.

# Particiones
EFI_PART="/dev/nvme0n1p1"
ROOT_PART="/dev/nvme0n1p4"
HOME_PART="/dev/nvme0n1p6"
MOUNTPOINT="/mnt"

# Sistema base
HOSTNAME="arch"
USERNAME="neo"
TIMEZONE="America/Lima"
LOCALE_GENERATE="en_US.UTF-8 UTF-8"
LOCALE_LANG="es_PE.UTF-8"
BOOTLOADER_ID="Arch"
EXTRA_PKGS="nano"

# Post-install
GREETER_CMD="tuigreet --cmd Hyperland"
GREETER_USER="greeter"
ENABLE_SEATD_GREETD="1"
ENABLE_AMD_STACK="1"
INSTALL_LIB32="1"
